{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core: B3WM https",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet-build-B3WM",
      "program": "${workspaceFolder}/B3WM/bin/Debug/net10.0/B3WM.dll",
      "args": [],
      "cwd": "${workspaceFolder}/B3WM",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/dashboard/"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5002;http://localhost:5000"
      }
    },
    {
      "name": "ExtractorRTD (Debug)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "ExtractorRTD",
      "program": "${workspaceFolder}/ExtractorRTD/bin/Debug/ExtractorRTD.exe",
      "args": [],
      "cwd": "${workspaceFolder}/ExtractorRTD/bin/Debug",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Python: B3WM MT5 Bridge",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/B3WM.Python",
      "console": "integratedTerminal"
    }
  ]
}
