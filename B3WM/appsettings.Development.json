{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "PythonService": {
    "BaseUrl": "http://localhost:8000"
  },
  "TypeSafe": {
    "BaseUrl": "https://api.typesafe.ai",
    "Model": "jev-latest",
    "TimeoutSeconds": 30
  },
  "StructureResearch": {
    "Enabled": true,
    "AtrPeriod": 14,
    "AtrMultiplierWinfut": 1.5,
    "AtrMultiplierWdofut": 1.0,
    "AtrFloorTicks": 5,
    "AtrCapTicks": 400,
    "WarmupDays": 3,
    "FalseBreakBarsShort": 10,
    "FalseBreakBarsLong": 20,
    "TimeFrames": [2],
    "Symbols": ["WINFUT", "WDOFUT"],
    "Persist": true
  }
}
