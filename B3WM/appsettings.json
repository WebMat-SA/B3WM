{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PythonService": {
    "BaseUrl": "http://localhost:8000"
  },
  "TypeSafe": {
    "BaseUrl": "https://api.typesafe.ai",
    "Model": "jev-latest",
    "TimeoutSeconds": 30
  },
  "StructureAtr": {
    "AtrPeriod": 14,
    "AtrMultiplierWinfut": 1.5,
    "AtrMultiplierWdofut": 1.0,
    "AtrDailyMultiplierWinfut": 0.3,
    "AtrDailyMultiplierWdofut": 1.0,
    "AtrFloorTicks": 5,
    "AtrCapTicks": 400,
    "AtrDailyFloorTicks": 20,
    "AtrDailyCapTicks": 2000
  }
}
