<Window x:Class="ExtractorRTD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extractor RTD"
        Height="700"
        Width="1200">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CONFIG -->
        <Border
            Grid.Row="0"
            BorderThickness="1"
            BorderBrush="Gray"
            Padding="10"
            Margin="0,0,0,10">

            <StackPanel>

                <TextBlock
                    Text="Multi T7T RTD Extractor"
                    FontWeight="Bold"
                    FontSize="18"
                    Margin="0,0,0,10"/>

                <TextBlock
                    Text="Server URL"
                    FontWeight="Bold"/>

                <TextBox
                    Text="{Binding Url}"
                    Margin="0,5,0,10"/>

                <TextBlock
                    Text="Mapeamento T7T -> Papel"
                    FontWeight="Bold"
                    Margin="0,0,0,5"/>

                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    Height="150"
                    ItemsSource="{Binding Tnts}">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="T7T"
                            Binding="{Binding TNTSymbol}"
                            Width="200"/>

                        <DataGridTemplateColumn
    Header="Papel"
    Width="250">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Symbol}"/>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>

                                    <ComboBox
                                        SelectedItem="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding DataContext.DataTypes,
                                        RelativeSource={RelativeSource AncestorType=Window}}"/>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

                    <Button
                        Width="220"
                        Height="35"
                        Content="Start / Stop Profit RTD"
                        Click="TimesAndTradesProfit_Click"/>

                    <Button
                        Width="100"
                        Height="35"
                        Margin="10,0,0,0"
                        Content="Clear"
                        Click="Clear_Click"/>

                    <Button
                        x:Name="SwapButton"
                        Width="120"
                        Height="35"
                        Margin="10,0,0,0"
                        Content="Swap T&amp;T"
                        ToolTip="Troca o papel das duas primeiras linhas T&amp;T mapeadas (só com RTD parado)"
                        Click="Swap_Click"/>

                    <TextBlock
                        x:Name="StatusTextBlock"
                        Margin="20,8,0,0"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="StatusTextBlockData"
                        Margin="20,8,0,0"
                        FontWeight="Bold"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- LISTAS -->
        <TabControl
            Grid.Row="2"
            Margin="5"
            ItemsSource="{Binding SymbolLogs}">

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding Symbol}"
                        Margin="8,2"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ListBox
                        ItemsSource="{Binding Messages}"
                        Margin="5"/>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </Grid>

</Window>